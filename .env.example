# LLM 模型配置 (进化管线用)
# 复制为 .env 并填入真实值
KIMI_MODEL_NAME=kimi-code/k3
KIMI_MODEL_PROVIDER_TYPE=openai
KIMI_MODEL_API_KEY=your-api-key-here
KIMI_MODEL_DISPLAY_NAME="K3"
KIMI_MODEL_MAX_CONTEXT_SIZE=1000000
KIMI_MODEL_THINKING_MODE=on

# 代理 (如需)
# HTTPS_PROXY=http://your-proxy:port
# HTTP_PROXY=http://your-proxy:port

# 可选: 覆盖 evolve_v3 用的模型
# KIMI_CLI_MODEL=kimi-code/k3
